{
    "name": "outlook-contact-enrichment-api",
    "version": "1.0.0",
    "description": "Secure backend API for Outlook Contact Enrichment Add-in",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
      "start": "node src/server.js",
      "dev": "nodemon src/server.js",
      "test": "jest --coverage",
      "lint": "eslint src/",
      "migrate": "node src/migrations/migrate.js",
