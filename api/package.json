      "jsonwebtoken": "^9.0.2",
      "mysql2": "^3.6.5",
      "morgan": "^1.10.0",
      "winston": "^3.11.0"
    },
    "devDependencies": {
      "eslint": "^8.56.0",
      "eslint-config-airbnb-base": "^15.0.0",
      "eslint-plugin-import": "^2.29.1",
      "jest": "^29.7.0",
      "nodemon": "^3.0.2",
      "supertest": "^6.3.3"
    },
    "engines": {
      "node": ">=16.0.0",
      "npm": ">=7.0.0"
    },
    "keywords": [
      "outlook",
      "add-in",
      "api",
      "jwt",
      "mysql"
