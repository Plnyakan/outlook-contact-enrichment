      "docker:run": "docker run -p 3000:3000 contact-enrichment-api"
    },
    "dependencies": {
      "bcrypt": "^5.1.1",
      "cors": "^2.8.5",
      "dotenv": "^16.3.1",
      "express": "^4.18.2",
